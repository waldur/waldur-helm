.DS_Store
.git

# CI fixtures and helm-unittest specs are consumed from the working tree, never
# from a packaged chart, so they have no business in the published tarball.
# Without these the release carries ~22 test files, including placeholder
# credentials (test/ssh/id_rsa, test/waldur_saml2/credentials/sp.pem) that read
# as secrets to anyone browsing the chart, and test/k8s/rabbitmq-cluster.yaml,
# which looks like a manifest a user is meant to apply.
#
# CI still reads these by path: `helm lint waldur/ -f waldur/test/values.yaml`
# and `helm unittest waldur/` both operate on the source tree, which .helmignore
# does not affect.
test/
tests/
